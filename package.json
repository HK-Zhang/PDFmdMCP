{
  "name": "pdf-to-markdown-mcp",
  "version": "1.2.0",
  "description": "MCP server that converts PDF pages to markdown using Qwen VL model",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": {
    "pdf-to-markdown-mcp": "dist/src/index.js"
  },
  "scripts": {
    "prebuild": "npm audit --omit=dev --audit-level=moderate",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "tsc --watch",
    "test": "tsc && node dist/test/convertPdfPageToImage.test.js && node dist/test/openaiCompatibleRequest.test.js",
    "test:full": "tsc && node dist/test/pdfToMarkdown.test.js",
    "test:all": "npm test && npm run test:full",
    "demo": "tsc && node dist/test/demo.js"
  },
  "keywords": [
    "mcp",
    "pdf",
    "markdown",
    "qwen"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "canvas": "3.2.0",
    "dotenv": "^16.6.1",
    "pdfjs-dist": "4.8.69",
    "zod": "^3.25.76"
  },
  "overrides": {
    "hono":"4.12.27",
    "ajv":"8.18.0",
    "fast-uri":"3.1.2",
    "ip-address":"10.2.0",
    "@hono/node-server":"1.19.14",
    "path-to-regexp":"8.4.2",
    "qs":"6.15.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
